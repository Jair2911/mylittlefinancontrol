<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyLittleFinanControl" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
<!--        color primario-->
        <item name="colorPrimary">@color/verde_oscuro</item>
<!--        color sobre el color primario -->
        <item name="colorOnPrimary">@color/verde_claro</item>

<!--        color para tarietas verdes trasnsparentes-->
        <item name="colorPrimaryContainer">@color/verde_transparente</item>
        <item name="colorOnPrimaryContainer">@color/verde_negro</item>

<!--        color secundario-->
        <item name="colorSecondary">@color/white</item>
<!--        color sobre el color secundario-->
        <item name="colorOnSecondary">@color/secondary</item>

<!--        color borde primario-->
        <item name="colorOutline">@color/verde_negro</item>

<!--        titulos y subtitulos-->
        <item name="colorOnSurface">@color/verde_negro</item>

        <!-- Fondos y Superficies -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/verde_transparente</item>
<!--        fondo rojo-->
        <item name="colorError">@color/accent_alerta</item>
<!--        texto color rojo-->
        <item name="colorOnError">@color/accent_alerta</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MyLittleFinanControl" parent="Base.Theme.MyLittleFinanControl" />
</resources>