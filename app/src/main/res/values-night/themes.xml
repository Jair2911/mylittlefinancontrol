<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme: DABA Design System — Engineered Obsidian (v2.4 Dark) -->
    <style name="Base.Theme.MyLittleFinanControl" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Marca Primaria: Esmeralda Precision (#00C853) -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorOnPrimary">#0A140A</item>

        <!-- Contenedores Primarios -->
        <item name="colorPrimaryContainer">@color/surface_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_emerald</item>

        <!-- Acento Secundario -->
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">#0A140A</item>

        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Acento Terciario / Badges -->
        <item name="colorTertiary">@color/income_green_bg</item>
        <item name="colorOnTertiary">@color/badge_paid_text</item>

        <!-- Bordes y Separadores Técnicos (#273829) -->
        <item name="colorOutline">@color/border_subtle</item>

        <!-- Fondos y Superficies Obsidian (#121412 Canvas / #1A1C1A Surface Card) -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Alertas y Errores -->
        <item name="colorError">@color/expense_red</item>
        <item name="colorErrorContainer">@color/expense_red_bg</item>
        <item name="colorOnError">#0A140A</item>
        <item name="colorOnErrorContainer">@color/on_expense_red</item>

        <!-- Status Bar Oscura Obsidian (#121412) -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Menús emergentes y desplegables -->
        <item name="popupMenuBackground">@color/surface_card</item>
        <item name="android:popupBackground">@color/surface_card</item>

        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>

        <!-- Formas DABA Design System (16dp Cards, 12dp Inputs, 9999dp Chips) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DABA.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DABA.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DABA.Large</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.MyLittleFinanControl" parent="Base.Theme.MyLittleFinanControl" />
</resources>