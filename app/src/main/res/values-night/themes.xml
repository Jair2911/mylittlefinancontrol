<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyLittleFinanControl" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">@color/verde_claro</item>
        <item name="colorOnPrimary">@color/verde_oscuro</item>
        <item name="colorPrimaryContainer">@color/verde_negro</item>
        <item name="colorOnPrimaryContainer">@color/verde_transparente</item>

        <item name="colorOutline">@color/verde_claro</item>

        <!-- Fondos y Superficies -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/background_light</item>

        <!-- Errores/Alertas -->
        <item name="colorError">@color/accent_alerta</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MyLittleFinanControl" parent="Base.Theme.MyLittleFinanControl" />
</resources>