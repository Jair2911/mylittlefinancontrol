<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme: Modern Financial Balance Dark Mode -->
    <style name="Base.Theme.MyLittleFinanControl" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Marca Primaria Esmeralda en Modo Oscuro -->
        <item name="colorPrimary">@color/dark_primary_emerald</item>
        <item name="colorOnPrimary">@color/dark_surface_bg</item>

        <item name="colorPrimaryContainer">#064E3B</item>
        <item name="colorOnPrimaryContainer">#A7F3D0</item>

        <item name="colorSecondary">@color/dark_primary_emerald</item>
        <item name="colorOnSecondary">@color/dark_surface_bg</item>

        <item name="colorSecondaryContainer">@color/dark_surface_card</item>
        <item name="colorOnSecondaryContainer">@color/dark_text_primary</item>

        <item name="colorTertiary">#064E3B</item>
        <item name="colorOnTertiary">#6EE7B7</item>

        <item name="colorOutline">@color/dark_surface_container</item>

        <item name="android:windowBackground">@color/dark_surface_bg</item>
        <item name="colorSurface">@color/dark_surface_card</item>
        <item name="colorSurfaceVariant">@color/dark_surface_container</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>

        <item name="colorError">#F87171</item>
        <item name="colorErrorContainer">#7F1D1D</item>
        <item name="colorOnError">@color/dark_surface_bg</item>
        <item name="colorOnErrorContainer">#FCA5A5</item>

        <item name="android:statusBarColor">@color/dark_surface_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="popupMenuBackground">@color/dark_surface_card</item>
        <item name="android:popupBackground">@color/dark_surface_card</item>

        <item name="colorSurfaceContainer">@color/dark_surface_card</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_bg</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container</item>
        <item name="colorSurfaceContainerHighest">#475569</item>
    </style>

    <style name="Theme.MyLittleFinanControl" parent="Base.Theme.MyLittleFinanControl" />
</resources>