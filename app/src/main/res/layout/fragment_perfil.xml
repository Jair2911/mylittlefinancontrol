<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imagenFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background_1"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Fragmentos.FragmentPerfil">

        <RelativeLayout
            android:id="@+id/rel_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">

            <!-- Nombres -->
            <TextView
                android:id="@+id/txt_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/txt_nombre"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_nombres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:textColor="?attr/colorPrimary"
                android:text="@string/tv_nombres" />

            <!-- email -->
            <TextView
                android:id="@+id/txt_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_nombres"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/txt_email"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_nombres"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="20dp"
                android:text="@string/tv_email" />

            <!-- proveedor -->
            <TextView
                android:id="@+id/txt_proveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_email"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/txt_proveedor"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_proveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_email"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="20dp"
                android:text="@string/tv_proveedor" />

            <!-- miembro desde -->
            <TextView
                android:id="@+id/txt_mienbro_Desde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_proveedor"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/txt_mienbro_Desde"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mienbro_Desde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_proveedor"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="20dp"
                android:text="@string/tv_mienbro_Desde" />

            <!-- Tema Oscuro Switch -->
            <TextView
                android:id="@+id/txt_tema_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_mienbro_Desde"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/txt_tema_oscuro"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_tema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_mienbro_Desde"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizar"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/sw_tema"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="300dp"
                android:text="@string/btnActualizar"
                android:textAllCaps="true"
                android:textSize="14sp"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnActualizar"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="@string/btn_logout"
                android:textAllCaps="true"
                android:textSize="14sp"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="8dp" />

        </RelativeLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>