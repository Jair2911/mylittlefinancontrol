<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".Fragmentos.FragmentBalance">

    <!-- Tarjeta de Total Deudas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_total_deudas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#15E55555"
        app:strokeWidth="1dp"
        app:strokeColor="#30E55555">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL DEUDAS RESTANTE"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_total_deudas_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="32sp"
                android:textColor="@color/accent_alerta"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Lista de Deudas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_deudas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cv_total_deudas"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_deuda" />

    <!-- Botón Agregar Deuda -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar_deuda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:tint="@color/white"
        android:contentDescription="@string/txt_agregar_deuda" />

</RelativeLayout>
