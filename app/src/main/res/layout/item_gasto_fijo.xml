<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/primary_glass"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="1dp"
    app:strokeColor="@color/primary">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/ll_acciones"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_concepto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONCEPTO"
                android:textAllCaps="true"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1000000"
                android:textSize="15sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tv_categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="CATEGORÍA"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tv_pago_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Día 15 - Mensual"
                android:textSize="11sp"
                android:textColor="@color/primary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_acciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iv_editar"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary"
                android:layout_width="28dp"
                android:layout_height="28dp"/>

            <ImageView
                android:id="@+id/iv_eliminar"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_delete"
                android:layout_marginEnd="10dp"
                app:tint="@color/accent_alerta"
                android:layout_width="28dp"
                android:layout_height="28dp" />
        </LinearLayout>



    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
