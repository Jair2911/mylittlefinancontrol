<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSecondaryContainer"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOnSurface">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/ll_acciones"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="1dp">

                <ImageView
                    android:id="@+id/iv_icono_deuda"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_gastos_fijos"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_concepto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="Concepto"
                    android:layout_centerVertical="true"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_monto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1000000"
                android:textSize="15sp"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Categoria"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:id="@+id/tv_pago_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Día 15 - Mensual"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_acciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_editar"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorPrimary"
                android:layout_width="28dp"
                android:layout_height="28dp"/>

            <ImageView
                android:id="@+id/iv_eliminar"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_delete"
                android:layout_marginEnd="10dp"
                app:tint="?attr/colorError"
                android:layout_width="28dp"
                android:layout_height="28dp" />
        </LinearLayout>



    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
