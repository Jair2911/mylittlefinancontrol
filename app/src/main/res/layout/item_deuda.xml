<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Section: Icon + Title + Badges + Amount -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Circular / Rounded Icon Container -->
            <FrameLayout
                android:id="@+id/fl_icono_deuda"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/badge_round_pill"
                android:backgroundTint="@color/surface_container_low">

                <ImageView
                    android:id="@+id/iv_icono_deuda"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_credit_card"
                    app:tint="@color/primary_emerald" />
            </FrameLayout>

            <!-- Monto a la derecha -->
            <LinearLayout
                android:id="@+id/ll_monto_top_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_label_monto_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo total"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_valor_restante_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="$ 100.000,00"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Concepto, Tipo y Plazo en el centro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_toEndOf="@id/fl_icono_deuda"
                android:layout_toStartOf="@id/ll_monto_top_container"
                android:orientation="vertical">

                <!-- Título + Badge Estado (En Curso / Al Día) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_concepto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="TEST DEUDA"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_round_pill"
                        android:backgroundTint="@color/debt_amber_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1.5dp"
                        android:text="EN CURSO"
                        android:textColor="@color/debt_amber"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_tipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tarjeta de crédito"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_fechas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/badge_round_pill"
                    android:backgroundTint="@color/surface_container_low"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Plazo: 18 ago 2026 - 28 ago 2026"
                    android:textColor="@color/primary_emerald"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Caja de Nota / Descripción Opcional -->
        <LinearLayout
            android:id="@+id/ll_nota_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/badge_round_pill"
            android:backgroundTint="@color/surface_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Nota: &quot;deuda&quot;"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Barra de Progreso de Amortización -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/surface_container_high" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tv_pagado_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Pagado: $ 0,00"
                android:textColor="@color/primary_emerald"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_restante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Restante: $ 100.000,00"
                android:textColor="@color/expense_red"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/pb_deuda"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/pb_savings_plan" />

        <!-- Barra Inferior de Acciones (Editar, Eliminar, Abonar Cuota) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- Botones Izquierda: Editar & Eliminar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/iv_editar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/badge_round_pill"
                    android:backgroundTint="@color/surface_container_low"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/iv_eliminar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/badge_round_pill"
                    android:backgroundTint="@color/expense_red_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/on_expense_red" />
                </FrameLayout>
            </LinearLayout>

            <!-- Botón Derecha: + Abonar cuota -->
            <LinearLayout
                android:id="@+id/btn_abonar_cuota"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_round_pill"
                android:backgroundTint="@color/surface_container_low"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tv_btn_abonar_texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Abonar cuota"
                    android:textColor="@color/primary_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>