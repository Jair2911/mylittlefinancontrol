<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <RelativeLayout
        android:id="@+id/toolbarRL"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="?attr/colorPrimary">

        <ImageButton
            android:id="@+id/btnPerfilToolbar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_perfil"
            android:background="@android:color/transparent"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            app:tint="?attr/colorPrimaryContainer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:id="@+id/app_name"
            android:textSize="20sp"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimaryContainer"/>

        <ImageButton
            android:id="@+id/btnGeminiAdvisor"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_toStartOf="@id/ic_sign_out"
            android:src="@drawable/ic_lightbulb"
            android:background="@android:color/transparent"
            android:layout_centerVertical="true"
            android:contentDescription="Asesor Gemini"
            app:tint="?attr/colorPrimaryContainer"/>

        <ImageButton
            android:id="@+id/ic_sign_out"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_sign_out"
            android:background="@android:color/transparent"
            android:layout_centerVertical="true"
            android:contentDescription="Cerrar Sesión"
            app:tint="?attr/colorPrimaryContainer"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorPrimary"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarRL"
        android:layout_above="@+id/view"
        android:id="@+id/fragmentoFL"/>

    <View
        android:id="@+id/view"
        android:background="?attr/colorPrimary"
        android:layout_above="@+id/botonNV"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/botonNV"
        android:layout_alignParentBottom="true"
        app:menu="@menu/menu_bottom"
        app:itemIconTint="?attr/colorPrimaryContainer"
        app:itemTextColor="?attr/colorPrimaryContainer"
        android:background="?attr/colorPrimary"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:labelVisibilityMode="labeled"/>

</RelativeLayout>
