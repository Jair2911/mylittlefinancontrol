<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".Fragmentos.FragmentMovimiento">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_movimientos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- 1. Tarjeta Resumen de Periodo (Hero de Movimientos) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_resumen_mov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Selector de Periodo: Mes & Año estilizados + Botón Exportar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Selector de Mes -->
                            <LinearLayout
                                android:id="@+id/btn_selector_mes"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/badge_round_pill"
                                android:backgroundTint="@color/surface_container"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_calendar_month"
                                    app:tint="@color/primary_emerald" />

                                <TextView
                                    android:id="@+id/tv_mes_seleccionado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Septiembre"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>

                            <!-- Selector de Año -->
                            <LinearLayout
                                android:id="@+id/btn_selector_anio"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/badge_round_pill"
                                android:backgroundTint="@color/surface_container_low"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:id="@+id/tv_anio_seleccionado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2026"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Botón Exportar -->
                        <FrameLayout
                            android:id="@+id/btn_exportar_reporte"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_container_low"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_share"
                                app:tint="@color/text_secondary" />
                        </FrameLayout>
                    </RelativeLayout>

                    <!-- Métricas Principales: Total y Badge de Registros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_titulo_balance_mov"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="TOTAL DE MOVIMIENTOS"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_container"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/circle_primary_bg"
                                android:backgroundTint="@color/primary_emerald" />

                            <TextView
                                android:id="@+id/tv_conteo_registros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="0 Registros"
                                android:textColor="@color/primary_emerald"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Monto Principal y Botón Ocultar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_total_mov_monto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="$ 100.000,00"
                            android:textColor="@color/text_primary"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btn_toggle_privacidad_mov"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Ocultar saldo"
                            android:padding="6dp"
                            android:src="@drawable/ic_visibility"
                            app:tint="@color/text_secondary" />
                    </RelativeLayout>

                    <!-- Desglose Rápido: Ingresos vs Egresos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Pastilla Ingresos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_container_low"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/circle_primary_bg"
                                android:backgroundTint="@color/primary_fixed">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_arrow_downward"
                                    app:tint="@color/primary_emerald" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ingresos"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_total_ingresos_monto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+$ 240.000"
                                    android:textColor="@color/primary_emerald"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Pastilla Egresos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_container_low"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="@drawable/circle_primary_bg"
                                android:backgroundTint="@color/expense_red_bg">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_arrow_upward"
                                    app:tint="@color/on_expense_red" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Egresos"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tv_total_egresos_monto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-$ 140.000"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Buscador y Filtros Rápidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <!-- Barra de Búsqueda -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/badge_round_pill"
                    android:backgroundTint="@color/surface_card"
                    android:elevation="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/et_buscar_movimientos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar por concepto o comercio..."
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/iv_filtro_avanzado"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Chips de Filtrado Horizontal -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_filtro_todos"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/primary_emerald"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="Todos"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_gastos_fijos"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Gastos Fijos"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_supermercado"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Supermercado"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_ingresos"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Ingresos"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_deudas"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Deudas"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_servicios"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Servicios"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_comida"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Comida"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_transporte"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Transporte"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_salud"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Salud"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_streaming"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Streaming"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_educacion"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Educación"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_filtro_otros"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/badge_round_pill"
                            android:backgroundTint="@color/surface_card"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Otros"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 3. Lista de Movimientos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notasRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_movimiento" />

            <!-- Botón Cargar 5 Más (Paginación acumulativa) -->
            <LinearLayout
                android:id="@+id/ll_cargar_mas_movimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btn_cargar_mas"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/badge_round_pill"
                    android:backgroundTint="@color/surface_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_autorenew"
                        app:tint="@color/primary_emerald" />

                    <TextView
                        android:id="@+id/tv_btn_cargar_mas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Cargar 10 anteriores"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Indicador de Final de Lista -->
            <LinearLayout
                android:id="@+id/ll_final_lista_movimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_primary_bg"
                    android:backgroundTint="@color/surface_container">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_done_all"
                        app:tint="@color/primary_emerald" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_final_lista_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Has revisado todos los movimientos del periodo"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Todos los registros cargados exitosamente"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB para agregar movimiento -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/FABAgregarNota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Agregar movimiento"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_emerald"
        app:elevation="6dp"
        app:fabCustomSize="56dp"
        app:maxImageSize="28dp"
        app:tint="@android:color/white" />

</RelativeLayout>